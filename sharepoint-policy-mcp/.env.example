# Copy to .env and fill in. .env is gitignored - keep it that way.
# Load it into your shell with:  set -a && . ./.env && set +a

# mock | graph   (graph is not implemented yet - see the README roadmap)
SP_AUTH_MODE=mock

# Site: "contoso/sites/aml", a host and path, or a full https URL.
# Not needed for mock.
# SP_SITE_URL=contoso/sites/aml-policy

# --- SP_AUTH_MODE=graph ---
# Entra ID app registration with Sites.Selected, granted on the policy site only.
# SP_TENANT_ID=
# SP_CLIENT_ID=
# SP_CLIENT_SECRET=

# --- Retrieval ---
# lexical | hybrid. Stays lexical by default: the only embedder in the tree is
# a lexical test rig, so fusing it with BM25 adds a second opinion drawn from
# the same evidence. Switch to hybrid once a real embedder is configured.
# SP_RETRIEVAL=lexical
# SP_EMBEDDING_DIMENSIONS=512

# --- Guardrails (all optional; defaults shown) ---
# SP_ALLOWED_LIBRARIES=BSA Policies,QA Policies,QC Policies
# Entitlement groups assumed for the caller. A stopgap: in production these
# must come from the signed-in user, not from this file. See the README.
# SP_USER_GROUPS=aml-analyst
# SP_MAX_LIMIT=10
# SP_DEFAULT_LIMIT=5
# SP_MAX_PASSAGE_CHARS=1200
# SP_REDACT=true
# SP_TIMEOUT=20
# SP_MAX_RETRIES=3
# SP_LOG_LEVEL=INFO
