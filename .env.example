# Copy to .env and fill in. .env is gitignored - keep it that way.
# Load it into your shell with:  set -a && . ./.env && set +a

# mock | oauth | basic
SN_AUTH_MODE=mock

# Instance: bare name, host, or full https URL. Not needed for mock.
# SN_INSTANCE=dev12345

# --- SN_AUTH_MODE=oauth (preferred) ---
# Create these in ServiceNow: System OAuth > Application Registry >
# "Create an OAuth API endpoint for external clients"
# SN_CLIENT_ID=
# SN_CLIENT_SECRET=

# --- SN_AUTH_MODE=basic (local development only, never production) ---
# SN_USERNAME=
# SN_PASSWORD=

# --- Guardrails (all optional; defaults shown) ---
# SN_ALLOWED_TABLES=incident,problem,change_request,sc_request,sys_user,sn_customerservice_case
# SN_MAX_LIMIT=50
# SN_DEFAULT_LIMIT=10
# SN_REDACT=true
# SN_TIMEOUT=20
# SN_MAX_RETRIES=3
# SN_LOG_LEVEL=INFO
